{
	"name": "syswraith-holocron",
	"version": "1.0.0",
	"description": "Syswraith's Holocron — personal blog built with Eleventy.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/blog/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/blog/ --serve --quiet"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/syswraith/syswraith-holocron.git"
	},
	"author": "Aryan Karekar (https://github.com/syswraith)",
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.7",
		"@11ty/eleventy-img": "^7.0.0",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.1.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"luxon": "^3.7.2",
		"markdown-it-attrs": "^5.0.1",
		"markdown-it-task-lists": "^2.1.1",
		"prismjs": "^1.30.0"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5"
	}
}